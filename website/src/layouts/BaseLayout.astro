---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<html lang="en" data-theme="light">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  main {
    flex: 1;
    padding-top: 64px; /* Header height */
  }
</style>

<script is:inline>
  (async function initMermaid() {
    var blocks = document.querySelectorAll('pre > code.language-mermaid, pre.language-mermaid code, pre[data-language="mermaid"] code');
    if (blocks.length === 0) return;

    // Load mermaid via script tag (CDN ESM import is unreliable)
    if (!window.mermaid) {
      var script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js';
      await new Promise(function(resolve, reject) {
        script.onload = resolve;
        script.onerror = reject;
        document.head.appendChild(script);
      });
    }

    var isDark = document.documentElement.dataset.theme === 'dark';
    mermaid.initialize({ startOnLoad: false, theme: isDark ? 'dark' : 'default' });

    for (var i = 0; i < blocks.length; i++) {
      var code = blocks[i];
      var pre = code.parentElement;
      var chart = code.textContent.trim();
      var container = document.createElement('div');
      container.className = 'mermaid';
      try {
        var result = await mermaid.render('mermaid-' + i + '-' + Date.now(), chart);
        container.innerHTML = result.svg;
      } catch (e) {
        container.textContent = chart;
        console.warn('Mermaid render failed:', e);
      }
      pre.parentNode.replaceChild(container, pre);
    }
  })();
</script>
