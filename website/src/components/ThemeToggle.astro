---
// ThemeToggle.astro — Dropdown theme picker: Light / Dark / System
---

<div class="theme-picker">
  <button
    class="theme-toggle"
    type="button"
    aria-label="Toggle color theme"
    aria-haspopup="true"
    aria-expanded="false"
  >
    <!-- Sun icon (Lucide) -->
    <svg class="icon icon-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4"/>
      <path d="M12 2v2"/>
      <path d="M12 20v2"/>
      <path d="m4.93 4.93 1.41 1.41"/>
      <path d="m17.66 17.66 1.41 1.41"/>
      <path d="M2 12h2"/>
      <path d="M20 12h2"/>
      <path d="m6.34 17.66-1.41 1.41"/>
      <path d="m19.07 4.93-1.41 1.41"/>
    </svg>
    <!-- Moon icon (Lucide) -->
    <svg class="icon icon-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
    </svg>
    <!-- Monitor icon (Lucide) -->
    <svg class="icon icon-monitor" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect width="20" height="14" x="2" y="3" rx="2"/>
      <line x1="8" x2="16" y1="21" y2="21"/>
      <line x1="12" x2="12" y1="17" y2="21"/>
    </svg>
  </button>

  <div class="theme-dropdown" role="menu">
    <button class="theme-option" role="menuitem" data-theme-value="light">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2"/>
        <path d="M12 20v2"/>
        <path d="m4.93 4.93 1.41 1.41"/>
        <path d="m17.66 17.66 1.41 1.41"/>
        <path d="M2 12h2"/>
        <path d="M20 12h2"/>
        <path d="m6.34 17.66-1.41 1.41"/>
        <path d="m19.07 4.93-1.41 1.41"/>
      </svg>
      <span>Light</span>
      <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6 9 17l-5-5"/>
      </svg>
    </button>
    <button class="theme-option" role="menuitem" data-theme-value="dark">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
      </svg>
      <span>Dark</span>
      <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6 9 17l-5-5"/>
      </svg>
    </button>
    <button class="theme-option" role="menuitem" data-theme-value="system">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="20" height="14" x="2" y="3" rx="2"/>
        <line x1="8" x2="16" y1="21" y2="21"/>
        <line x1="12" x2="12" y1="17" y2="21"/>
      </svg>
      <span class="system-label">System</span>
      <span class="system-hint"></span>
      <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6 9 17l-5-5"/>
      </svg>
    </button>
  </div>
</div>

<style>
  .theme-picker {
    position: relative;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: var(--color-bg);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    color: var(--color-text);
    transition: background 0.15s ease;
  }

  .theme-toggle:hover {
    background: var(--color-bg-alt);
  }

  .icon {
    display: none;
  }

  /* Show icon based on current effective theme */
  :global([data-theme="light"]:not([data-theme-mode="system"])) .icon-sun {
    display: block;
  }

  :global([data-theme="dark"]:not([data-theme-mode="system"])) .icon-moon {
    display: block;
  }

  :global([data-theme-mode="system"]) .icon-monitor {
    display: block;
  }

  /* Dropdown */
  .theme-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    min-width: 180px;
    background: var(--color-bg);
    border: var(--border);
    border-radius: 10px;
    box-shadow: var(--shadow);
    padding: 4px;
    z-index: 1100;
  }

  .theme-picker.open .theme-dropdown {
    display: block;
  }

  .theme-option {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 8px 10px;
    background: none;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 500;
    text-align: left;
    transition: background 0.1s ease;
  }

  .theme-option:hover {
    background: var(--color-bg-alt);
  }

  .theme-option .check-icon {
    display: none;
    margin-left: auto;
    color: var(--color-accent);
  }

  .theme-option.active .check-icon {
    display: block;
  }

  .system-hint {
    font-size: 11px;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .system-label {
    flex-shrink: 0;
  }
</style>

<script>
  (function () {
    const picker = document.querySelector('.theme-picker');
    const btn = document.querySelector('.theme-toggle');
    const dropdown = document.querySelector('.theme-dropdown');
    if (!picker || !btn || !dropdown) return;

    const STORAGE_KEY = 'theme';
    const options = dropdown.querySelectorAll('.theme-option');
    const systemHint = dropdown.querySelector('.system-hint');

    function getEffectiveMode(): string {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored === 'light' || stored === 'dark') return stored;
      return 'system';
    }

    function getSystemPreference(): string {
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function applyTheme(theme: string) {
      if (theme === 'system') {
        localStorage.removeItem(STORAGE_KEY);
        const actual = getSystemPreference();
        document.documentElement.setAttribute('data-theme', actual);
        document.documentElement.setAttribute('data-theme-mode', 'system');
        document.documentElement.style.colorScheme = actual;
      } else {
        localStorage.setItem(STORAGE_KEY, theme);
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.removeAttribute('data-theme-mode');
        document.documentElement.style.colorScheme = theme;
      }
      updateUI();
    }

    function updateUI() {
      const mode = getEffectiveMode();
      options.forEach((opt) => {
        const value = (opt as HTMLElement).dataset.themeValue;
        opt.classList.toggle('active', value === mode);
      });
      if (systemHint) {
        const pref = getSystemPreference();
        systemHint.textContent = pref === 'dark' ? '(dark)' : '(light)';
      }
    }

    // Toggle dropdown
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = picker.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(isOpen));
      if (isOpen) updateUI();
    });

    // Option click
    options.forEach((opt) => {
      opt.addEventListener('click', () => {
        const value = (opt as HTMLElement).dataset.themeValue;
        if (value) applyTheme(value);
        picker.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      });
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!picker.contains(e.target as Node)) {
        picker.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        picker.classList.remove('open');
        btn.setAttribute('aria-expanded', 'false');
      }
    });

    // Listen for system preference changes
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (getEffectiveMode() === 'system') {
        applyTheme('system');
      }
    });

    // Initial UI state
    updateUI();
  })();
</script>
