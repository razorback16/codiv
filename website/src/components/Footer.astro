---
// Footer.astro — Simple site footer
---

<footer class="site-footer">
  <div class="footer-inner container">
    <span class="footer-left">Codiv &mdash; GPLv3 License</span>
    <a
      href="https://github.com/razorback16/codiv"
      class="footer-link"
      target="_blank"
      rel="noopener noreferrer"
    >
      GitHub
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true" style="display:inline;vertical-align:middle;margin-left:2px;">
        <path d="M7 17L17 7M17 7H7M17 7v10"/>
      </svg>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--border);
    padding: var(--space-6) 0;
    margin-top: auto;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-left {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .footer-link {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: var(--color-accent);
  }
</style>
