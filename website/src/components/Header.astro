---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <div class="header-inner container">
    <a href="/" class="logo-link" aria-label="Codiv home">
      <!-- Inline logo icon -->
      <svg class="logo-icon" viewBox="0 0 40 40" width="32" height="32" fill="none" aria-hidden="true">
        <polyline points="8,10 20,20 8,30" stroke="currentColor" stroke-width="4" stroke-linecap="square" stroke-linejoin="miter"/>
        <line x1="22" y1="30" x2="34" y2="30" stroke="var(--color-accent)" stroke-width="4" stroke-linecap="square"/>
        <line x1="30" y1="8" x2="24" y2="16" stroke="currentColor" stroke-width="1.5"/>
        <line x1="30" y1="8" x2="36" y2="16" stroke="currentColor" stroke-width="1.5"/>
        <line x1="24" y1="16" x2="36" y2="16" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="30" cy="8" r="2" fill="currentColor"/>
        <circle cx="24" cy="16" r="2" fill="currentColor"/>
        <circle cx="36" cy="16" r="2" fill="currentColor"/>
      </svg>
      <span class="logo-text">codiv</span>
    </a>

    <!-- Mobile hamburger (checkbox hack) -->
    <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox sr-only" aria-label="Toggle navigation"/>
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Open menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line class="hamburger-top" x1="3" y1="6" x2="21" y2="6"/>
        <line class="hamburger-mid" x1="3" y1="12" x2="21" y2="12"/>
        <line class="hamburger-bot" x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </label>

    <nav class="nav">
      <a href="/docs/getting-started/installation/" class="nav-link">Docs</a>
      <a href="https://github.com/razorback16/slate-agent" class="nav-link" target="_blank" rel="noopener noreferrer">
        GitHub
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="display:inline;vertical-align:middle;margin-left:2px;">
          <path d="M7 17L17 7M17 7H7M17 7v10"/>
        </svg>
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    height: 64px;
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: var(--border);
  }

  :global([data-theme="dark"]) .site-header {
    background-color: rgba(10, 10, 10, 0.9);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--color-text);
  }

  .logo-link:hover {
    color: var(--color-accent);
  }

  .logo-icon {
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-link {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  /* Hamburger toggle — hidden on desktop */
  .nav-toggle-checkbox,
  .nav-toggle-label {
    display: none;
  }

  /* Mobile styles */
  @media (max-width: 768px) {
    .nav-toggle-label {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      cursor: pointer;
      color: var(--color-text);
      border: none;
      border-radius: 8px;
      background: var(--color-bg);
      z-index: 10;
    }

    .nav {
      display: none;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background-color: var(--color-bg);
      border-bottom: var(--border);
      box-shadow: var(--shadow);
      padding: var(--space-4);
    }

    .nav-link {
      display: block;
      padding: var(--space-3) var(--space-4);
      border-bottom: 1px solid var(--color-border);
      font-size: var(--text-base);
    }

    .nav-link:last-of-type {
      border-bottom: none;
    }

    /* Show nav when checkbox is checked */
    .nav-toggle-checkbox:checked ~ .nav {
      display: flex;
    }

    /* Animate hamburger lines */
    .nav-toggle-checkbox:checked ~ .nav-toggle-label .hamburger-top {
      transform: rotate(45deg) translate(4px, 4px);
    }
    .nav-toggle-checkbox:checked ~ .nav-toggle-label .hamburger-mid {
      opacity: 0;
    }
    .nav-toggle-checkbox:checked ~ .nav-toggle-label .hamburger-bot {
      transform: rotate(-45deg) translate(4px, -4px);
    }
  }
</style>
