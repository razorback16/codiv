---
---

<section class="hero">
  <div class="container hero-inner">
    <h1 class="hero-heading">Your terminal, supercharged with AI</h1>
    <p class="hero-subheading">
      Codiv replaces your shell with an intelligent terminal that runs commands instantly and handles complex AI tasks — all in one interface.
    </p>
    <div class="hero-ctas">
      <a href="/docs/getting-started/installation/" class="btn btn-primary">Get Started</a>
      <a href="https://github.com/razorback16/slate-agent" class="btn btn-outline">View on GitHub</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-16) 0;
    text-align: center;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-heading {
    font-size: var(--text-6xl);
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.1;
    max-width: 800px;
    margin-bottom: var(--space-6);
  }

  .hero-subheading {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
    margin-bottom: var(--space-10);
    line-height: 1.6;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-ctas .btn {
    font-size: var(--text-base);
    padding: var(--space-4) var(--space-8);
  }

  @media (max-width: 768px) {
    .hero-heading {
      font-size: var(--text-4xl);
    }

    .hero-subheading {
      font-size: var(--text-lg);
    }
  }

  @media (max-width: 480px) {
    .hero-heading {
      font-size: var(--text-3xl);
    }

    .hero-ctas {
      flex-direction: column;
      align-items: center;
    }

    .hero-ctas .btn {
      width: 100%;
      max-width: 280px;
    }
  }
</style>
