---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/docs.css';

const docs = await getCollection('docs', ({ data }) => !data.draft);

const sectionOrder = ['Getting Started', 'Usage', 'Architecture', 'Design Docs', 'Contributing'];

const sectionDescriptions: Record<string, string> = {
  'Getting Started': 'Install Codiv, configure your LLM provider, and run your first AI-assisted command.',
  'Usage': 'Learn how commands are classified, how AI mode works, and the built-in tool suite.',
  'Architecture': 'Understand the client-daemon split, IPC protocol, and crate structure.',
  'Design Docs': 'Deep dives into the agent system, work items, memory, safety, tools, and TUI.',
  'Contributing': 'Set up your dev environment, understand the code structure, and start contributing.',
};

// Group by section
const grouped = new Map<string, typeof docs>();
for (const entry of docs) {
  const section = entry.data.section;
  if (!grouped.has(section)) grouped.set(section, []);
  grouped.get(section)!.push(entry);
}

for (const entries of grouped.values()) {
  entries.sort((a, b) => a.data.order - b.data.order);
}

const sections = sectionOrder
  .filter((s) => grouped.has(s))
  .map((s) => ({ name: s, entries: grouped.get(s)!, description: sectionDescriptions[s] || '' }));
---

<BaseLayout title="Documentation — Codiv" description="Codiv documentation: installation, usage, architecture, and design docs.">
  <div class="docs-index container">
    <div class="docs-index-header">
      <h1>Documentation</h1>
      <p class="docs-index-lead">
        Everything you need to get started with Codiv — from installation to architecture deep dives.
      </p>
    </div>

    <div class="docs-index-sections">
      {sections.map((section) => (
        <div class="docs-index-section card">
          <h2>{section.name}</h2>
          <p class="docs-index-section-desc">{section.description}</p>
          <ul class="docs-index-links">
            {section.entries.map((entry) => (
              <li>
                <a href={`/slate-agent/docs/${entry.id}/`}>
                  {entry.data.title}
                </a>
                <span class="docs-index-link-desc">{entry.data.description}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .docs-index {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
  }

  .docs-index-header {
    margin-bottom: var(--space-12);
  }

  .docs-index-lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    max-width: 600px;
  }

  .docs-index-sections {
    display: grid;
    gap: var(--space-8);
  }

  .docs-index-section h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .docs-index-section-desc {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-bottom: var(--space-4);
  }

  .docs-index-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .docs-index-links li {
    padding: var(--space-2) 0;
    border-top: 1px solid var(--color-bg-alt);
    margin-bottom: 0;
  }

  .docs-index-links a {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .docs-index-link-desc {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-1);
  }
</style>
